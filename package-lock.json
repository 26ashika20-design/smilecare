/*
# Create appointments table for SmileCare Dental Clinic

1. Purpose
   Stores booking requests submitted from the public appointment form on the
   SmileCare Dental Clinic website. The clinic location is attached to every
   booking so the front desk knows which branch the patient is visiting.

2. New Tables
   - `appointments`
     - `id`            uuid, primary key
     - `name`          text, patient full name (required)
     - `phone`         text, contact phone (required)
     - `email`         text, contact email (required)
     - `treatment`     text, selected treatment/service (required)
     - `preferred_date` date, requested appointment date (required)
     - `preferred_time` text, requested time slot (required)
     - `message`       text, optional patient notes
     - `location`      text, clinic location/branch the patient is booking at (required)
     - `status`        text, booking status, defaults to 'pending'
                       (pending | confirmed | completed | cancelled)
     - `created_at`    timestamptz, defaults to now()

3. Security
   - Enable RLS on `appointments`.
   - This is a single-tenant public booking form (no sign-in screen), so the
     anon-key frontend must be able to INSERT new bookings and read its own
     submissions. SELECT/INSERT are open to anon + authenticated (the data is
     intentionally public-facing booking requests). UPDATE/DELETE are restricted
     to authenticated (clinic staff) so patients cannot mutate or delete
     bookings through the public anon key.

4. Notes
   - No user_id / auth.users linkage — the booking form is public.
   - `location` captures the sample clinic address so each booking is tied to
     a physical clinic branch.
*/

CREATE TABLE IF NOT EXISTS appointments (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  name text NOT NULL,
  phone text NOT NULL,
  email text NOT NULL,
  treatment text NOT NULL,
  preferred_date date NOT NULL,
  preferred_time text NOT NULL,
  message text,
  location text NOT NULL,
  status text NOT NULL DEFAULT 'pending',
  created_at timestamptz DEFAULT now()
);

ALTER TABLE appointments ENABLE ROW LEVEL SECURITY;

-- Public can read bookings (single-tenant, public form)
DROP POLICY IF EXISTS "anon_select_appointments" ON appointments;
CREATE POLICY "anon_select_appointments"
ON appointments FOR SELECT
TO anon, authenticated USING (true);

-- Public can submit new bookings
DROP POLICY IF EXISTS "anon_insert_appointments" ON appointments;
CREATE POLICY "anon_insert_appointments"
ON appointments FOR INSERT
TO anon, authenticated WITH CHECK (true);

-- Only authenticated staff can update booking status
DROP POLICY IF EXISTS "staff_update_appointments" ON appointments;
CREATE POLICY "staff_update_appointments"
ON appointments FOR UPDATE
TO authenticated USING (true) WITH CHECK (true);

-- Only authenticated staff can delete bookings
DROP POLICY IF EXISTS "staff_delete_appointments" ON appointments;
CREATE POLICY "staff_delete_appointments"
ON appointments FOR DELETE
TO authenticated USING (true);
